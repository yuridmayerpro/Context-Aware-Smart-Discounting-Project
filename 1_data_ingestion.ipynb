# COMMAND ----------

# MAGIC %md
# MAGIC # 📉 Unit COGS (Cost of Goods Sold) Data Preparation
# MAGIC
# MAGIC **Objective:** Ingest financial data, process costs, and calculate the unitary Cost of Goods Sold (COGS) per SKU.
# MAGIC **Output:** `finance_db.gold_hist_unit_cogs_ean`

# COMMAND ----------

# MAGIC %md
# MAGIC ## 📚 1. Libraries and Setup

# COMMAND ----------

from pyspark.sql import functions as F
from pyspark.sql.functions import col, lit, sum as spark_sum, when
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Set pandas display options for better visibility during checks
pd.set_option('display.max_columns', None)

# COMMAND ----------

# MAGIC %md
# MAGIC ## 📥 2. Data Ingestion
# MAGIC Loading raw parquet files from the Data Lake.

# COMMAND ----------

# Dimension: Account Ledger (Chart of Accounts)
path_dim_account = "dbfs:/mnt/datalake/finance/raw/smart_pricing/DIM_ACCOUNT/DIM_ACCOUNT.parquet"
df_dim_account = spark.read.parquet(path_dim_account)

# Dimension: Material Mapping (Product Hierarchy)
path_dim_material = "dbfs:/mnt/datalake/finance/raw/smart_pricing/DIM_MATERIAL_MAP/DIM_MATERIAL_MAP.parquet"
df_dim_material = spark.read.parquet(path_dim_material)

# Dimension: Calendar
path_dim_calendar = "dbfs:/mnt/datalake/finance/raw/smart_pricing/DIM_CALENDAR/DIM_CALENDAR.parquet"
df_dim_calendar = spark.read.parquet(path_dim_calendar)

# Fact: Financial Statements (DRE)
path_fact_financial = "dbfs:/mnt/datalake/finance/raw/smart_pricing/FACT_FINANCIAL/"
df_fact_financial = spark.read.parquet(path_fact_financial)

# COMMAND ----------

# Validate Calendar ID range
min_cal_id = df_dim_calendar.agg({"CALENDAR_ID": "min"}).collect()[0][0]
max_cal_id = df_dim_calendar.agg({"CALENDAR_ID": "max"}).collect()[0][0]

print(f"Calendar Range (Dim): {min_cal_id} to {max_cal_id}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## ⚙️ 3. Data Processing & Aggregation

# COMMAND ----------

# Verify data range in the Fact table
fact_max_cal = df_fact_financial.agg({"CALENDAR_ID": "max"}).collect()[0][0]
fact_min_cal = df_fact_financial.agg({"CALENDAR_ID": "min"}).collect()[0][0]

print(f"Fact Table Data Range: {fact_min_cal} to {fact_max_cal}")

# COMMAND ----------

# -------------------------------------------------------------------
# 1. Join Fact Table with Calendar to get Year-Month keys
# -------------------------------------------------------------------
# df_fact_financial: CALENDAR_ID, CLIENT_SK, MATERIAL_SK, ACCOUNT_SK, ACTUAL_VALUE
# df_dim_calendar: CALENDAR_ID, YEAR, MONTH, YEAR_MONTH

df_base = (
    df_fact_financial
    .join(
        df_dim_calendar.select("CALENDAR_ID", "YEAR_MONTH"),
        on="CALENDAR_ID",
        how="inner"
    )
)

# -------------------------------------------------------------------
# 2. Join with Material Dimension to get Unified SKU
# -------------------------------------------------------------------
# df_dim_material: MATERIAL_SK, BU_DESC, UNIFIED_SKU, OPERATION_DESC

df_base = (
    df_base
    .join(
        df_dim_material.select("MATERIAL_SK", "UNIFIED_SKU"),
        on="MATERIAL_SK",
        how="left"
    )
)

# -------------------------------------------------------------------
# 3. Join with Account Dimension to get Account Categories
# -------------------------------------------------------------------
# df_dim_account: ACCOUNT_SK, ACCOUNT_CATEGORY, CORPORATE_GROUP

df_base = (
    df_base
    .join(
        df_dim_account.select("ACCOUNT_SK", "ACCOUNT_CATEGORY"),
        on="ACCOUNT_SK",
        how="left"
    )
)

# -------------------------------------------------------------------
# 4. Filter only Cost of Goods Sold (COGS) accounts
# -------------------------------------------------------------------
# Assuming COGS accounts start with the specific prefix
df_cogs = df_base.filter(col("ACCOUNT_CATEGORY").startswith("COGS"))

# -------------------------------------------------------------------
# 5. Aggregate (Sum) Actual Value by Key Dimensions
# -------------------------------------------------------------------
df_grouped = (
    df_cogs
    .groupBy(
        col("YEAR_MONTH"),
        col("MATERIAL_SK"),
        col("UNIFIED_SKU"),
        col("ACCOUNT_CATEGORY")
    )
    .agg(
        spark_sum(col("ACTUAL_VALUE")).alias("ACTUAL_VALUE")
    )
)

# -------------------------------------------------------------------
# 6. Sort for inspection
# -------------------------------------------------------------------
df_grouped = df_grouped.orderBy("YEAR_MONTH", "MATERIAL_SK", "ACCOUNT_CATEGORY")

# Display sample for validation
display(df_grouped.limit(10))

# COMMAND ----------

# MAGIC %md
# MAGIC ## 🔗 4. Integration with Sales Volume
# MAGIC Calculation of unitary cost based on billed quantity.

# COMMAND ----------

# 1. Load and aggregate Billed Quantity by Year-Month and Product Code
# Fetching from the refined sales layer
query = """
SELECT
  YEAR_MONTH,
  PRODUCT_ID,
  EAN_CODE,
  SUM(BILLED_QTY) AS BILLED_QTY
FROM sales_db.refined_product_analysis
GROUP BY
  YEAR_MONTH,
  PRODUCT_ID,
  EAN_CODE
"""
df_sales = spark.sql(query)

# 2. Join Cost Data (df_grouped) with Sales Data (df_sales)
# Join condition: Year-Month match AND Unified SKU matches Product ID
df_with_sales = (
    df_grouped
        .join(
            df_sales,
            (df_grouped["YEAR_MONTH"] == df_sales["YEAR_MONTH"]) &
            (df_grouped["UNIFIED_SKU"] == df_sales["PRODUCT_ID"]),
            "inner"
        )
        .drop(df_sales["YEAR_MONTH"]) # Remove duplicate column
)

# 3. Calculate Unitary Cost
# Formula: Total Cost / Total Billed Quantity
df_unitary = (
    df_with_sales
        .select(
            col("YEAR_MONTH"),
            col("EAN_CODE"),
            col('PRODUCT_ID'),
            col("ACCOUNT_CATEGORY"),
            (col("ACTUAL_VALUE") / col("BILLED_QTY")).alias("REAL_UNIT_VALUE")
        )
        .orderBy("YEAR_MONTH", "EAN_CODE", "ACCOUNT_CATEGORY")
)

# Convert to Pandas for complex imputation logic in the next step
df_unitary_pd = df_unitary.toPandas()

# Ensure float type for calculations
df_unitary_pd['REAL_UNIT_VALUE'] = df_unitary_pd['REAL_UNIT_VALUE'].astype(float)

# COMMAND ----------

# Data Consistency Check: Product ID vs EAN Parity
# Ideally, the difference should be zero (1:1 mapping)
unique_products = df_unitary_pd.PRODUCT_ID.nunique()
unique_eans = df_unitary_pd.EAN_CODE.nunique()

print(f'Unique PRODUCT_IDs: {unique_products}')
print(f'Unique EANs: {unique_eans}')
print(f'Difference: {unique_products - unique_eans}')

# COMMAND ----------

# MAGIC %md
# MAGIC ## 🧹 5. Data Imputation & Cleanup
# MAGIC Handling nulls, zeros, and positive inconsistencies using historical averages.

# COMMAND ----------

# -------------------------------------------------------------------
# Adjustment of Nulls and Positive/Zero values using Historical Mean
# -------------------------------------------------------------------

# 1) Calculate Historical Mean per (EAN, ACCOUNT_CATEGORY)
# We only consider negative values as valid costs for the mean calculation
df_unitary_pd['historical_mean'] = (
    df_unitary_pd
    .groupby(['EAN_CODE', 'ACCOUNT_CATEGORY'])['REAL_UNIT_VALUE']
    .transform(lambda s: s[s < 0].mean())
)

# 2) Pre-imputation: Replace values >= 0 (invalid costs) with the historical mean
# Costs should be negative; if positive or zero, it's a data error.
df_unitary_pd['VALUE_POS_CORRECTED'] = df_unitary_pd['REAL_UNIT_VALUE'] \
    .mask(df_unitary_pd['REAL_UNIT_VALUE'] >= 0, df_unitary_pd['historical_mean'])

# 3) Final Imputation: Fill NaNs with the same historical mean
# (Using the column where positives were already corrected)
df_unitary_pd['FINAL_UNIT_VALUE'] = df_unitary_pd['VALUE_POS_CORRECTED'] \
    .fillna(df_unitary_pd['historical_mean'])

# 4) Remove auxiliary columns to keep the dataset clean
df_unitary_pd.drop(columns=['historical_mean', 'VALUE_POS_CORRECTED'], inplace=True)

# COMMAND ----------

# MAGIC %md
# MAGIC ## 💾 6. Saving Data

# COMMAND ----------

# 0) Ensure target database exists
spark.sql("CREATE DATABASE IF NOT EXISTS finance_db COMMENT 'Project Smart Pricing Database';")
spark.sql("USE finance_db")

# 1) Convert processed Pandas DataFrame back to Spark DataFrame
spark_df_final = spark.createDataFrame(df_unitary_pd)

# 2) Write as Delta Table (Overwrite mode)
target_table = "finance_db.gold_hist_unit_cogs_ean"

spark_df_final.write \
    .format("delta") \
    .mode("overwrite") \
    .option("overwriteSchema", "true") \
    .saveAsTable(target_table)

# 3) Add Table Metadata (Description)
spark.sql(f"""
ALTER TABLE {target_table}
SET TBLPROPERTIES (
  'comment' = '
    Historical Unit COGS (Cost of Goods Sold) per EAN and YEAR_MONTH.
    Contents:
      • REAL_UNIT_VALUE: Original unit value (may contain NaNs, zeros, or positive errors).
      • historical_mean: Historical mean of REAL_UNIT_VALUE per EAN/CATEGORY (calculated ignoring NaNs and positives).
      • FINAL_UNIT_VALUE: Adjusted values (zeros, positives, and nulls replaced by historical mean).
    
    Processing Logic:
      1. Calculated historical_mean per EAN/CATEGORY.
      2. Replaced invalid values (>= 0) with historical_mean.
      3. Imputed nulls with historical_mean.
  '
)
""")

# 4) Add Column Comments
column_comments = {
  "YEAR_MONTH":        "Observation Year and Month (YYYYMM)",
  "EAN_CODE":          "Product EAN Code",
  "PRODUCT_ID":        "Internal Product ID",
  "ACCOUNT_CATEGORY":  "Variable Cost Category (e.g., COGS - Total, Waste, etc.)",
  "REAL_UNIT_VALUE":   "Original Unit Value before adjustments",
  "FINAL_UNIT_VALUE":  "Final Unit Value: Adjusted for outliers and nulls using historical mean"
}

for col_name, comment in column_comments.items():
    spark.sql(f"""
      ALTER TABLE {target_table}
      ALTER COLUMN {col_name}
      COMMENT '{comment}'
    """)