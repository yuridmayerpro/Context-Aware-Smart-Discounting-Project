# COMMAND ----------

# MAGIC %md
# MAGIC # 🧹 Feature Engineering & Event Aggregation
# MAGIC
# MAGIC **Objective:** Process the raw transactional table, remove statistical outliers, and aggregate sales based on price change events (Long-term Qn).
# MAGIC **Input:** `finance_db.silver_sales_transactions`
# MAGIC **Output:** `finance_db.gold_sales_events_enriched`

# COMMAND ----------

# MAGIC %md
# MAGIC ## 📚 1. Libraries

# COMMAND ----------

import pandas as pd
import numpy as np
import datetime
from datetime import timedelta
import warnings

from pyspark.sql import functions as F
from pyspark.sql import DataFrame, Window
from pyspark.sql.types import DateType, FloatType

# Visualization
import matplotlib.pyplot as plt
import seaborn as sns

# Notebook Configuration
%matplotlib inline
sns.set_theme(style="whitegrid", palette="pastel")
warnings.filterwarnings('ignore')

# COMMAND ----------

# MAGIC %md
# MAGIC ## 📥 2. Data Ingestion
# MAGIC Reading the raw flat table created in the previous pipeline step.

# COMMAND ----------

df_raw = spark.table("finance_db.silver_sales_transactions")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 🧮 3. Outlier Removal & Data Cleaning

# COMMAND ----------

# Round net price to 2 decimal places to avoid floating point inconsistencies during comparison
df_raw = (
    df_raw
    .withColumn(
        'NET_PRICE_ROUND',
        F.round(F.col('NET_PRICE_UNIT'), 2)
    )
)

# 1) Remove rows with null margins
df_clean = df_raw.dropna(subset=['REAL_UNIT_MARGIN'])

# 2) Filter only positive margins (business rule)
df_clean = df_clean.filter(F.col('REAL_UNIT_MARGIN') > 0)

# 3) Define columns for outlier detection (Z-Score)
outlier_cols = [
    'BILLED_QTY',
    'LIST_PRICE_UNIT',
    'REAL_UNIT_MARGIN'
]

# 4) Calculate Mean and StdDev for each column
stats = (
    df_clean
    .agg(
        *[F.mean(c).alias(f'{c}_mean') for c in outlier_cols],
        *[F.stddev(c).alias(f'{c}_std') for c in outlier_cols]
    )
    .collect()[0]
)

# 5) Calculate Z-Score: (Value - Mean) / StdDev
for c in outlier_cols:
    mean_val = stats[f'{c}_mean']
    std_val  = stats[f'{c}_std']
    
    # Avoid division by zero if std_dev is 0
    if std_val is None or std_val == 0:
        std_val = 1
        
    df_clean = (
        df_clean
        .withColumn(
            f'{c}_zscore',
            (F.col(c) - F.lit(mean_val)) / F.lit(std_val)
        )
    )

# 6) Filter rows where |Z-Score| < 3 for all metrics
df_no_outliers = (
    df_clean
    .filter(
        (F.abs(F.col('BILLED_QTY_zscore'))       < 3) &
        (F.abs(F.col('LIST_PRICE_UNIT_zscore'))  < 3) &
        (F.abs(F.col('REAL_UNIT_MARGIN_zscore')) < 3)
    )
    # 7) Drop intermediate Z-Score columns
    .drop(*[f'{c}_zscore' for c in outlier_cols])
)

# COMMAND ----------

# MAGIC %md
# MAGIC ## ⏱️ 4. Long-term Sales Calculation (Qn)
# MAGIC Grouping transactions into "Price Events" to measure elasticity over time.

# COMMAND ----------

def compute_long_term_sales(
    df_input: DataFrame,
    n_weeks: int = 8,
    sales_col: str = 'BILLED_QTY',
    seg_cols: list = None,
    round_decimals: int = 2
) -> DataFrame:
    """
    Calculates the total sales for a specific segment during a "Price Event".
    A Price Event is defined as a period where the price remains constant.
    The window is limited by the start of the next price change OR by n_weeks.

    Args:
        df_input: Spark DataFrame containing sales transactions.
        n_weeks: Max duration to accumulate sales for an event.
        sales_col: The metric to aggregate (e.g., Qty).
        seg_cols: List of columns defining the segment (Product, Region, Channel).
        round_decimals: Precision for price comparison.

    Returns:
        DataFrame enriched with:
          - event_id   : Unique ID for the price event within the segment.
          - start_date : Start of the price application.
          - end_date   : End of the price application (or n_weeks limit).
          - Q{n_weeks} : Aggregated sales during the valid window.
    """
    
    if seg_cols is None:
        raise ValueError("Segmentation columns (seg_cols) must be provided.")

    # 1) Ensure Order Date is DateType and Price is rounded
    df = (
        df_input
        .withColumn('ORDER_DATE', F.col('ORDER_DATE').cast('date'))
        .withColumn('NET_PRICE_ROUND', F.round(F.col('NET_PRICE_UNIT'), round_decimals))
    )

    # 2) Detect Price Events using Window Functions
    # We flag a "Change" whenever the price differs from the previous row
    window_seg = Window.partitionBy(*seg_cols).orderBy('ORDER_DATE')
    
    df_with_events = (
        df
        .withColumn('prev_price', F.lag('NET_PRICE_ROUND').over(window_seg))
        .withColumn(
            'price_change',
            F.when(
                (F.col('NET_PRICE_ROUND') != F.col('prev_price')) | F.col('prev_price').isNull(),
                1
            ).otherwise(0)
        )
        # Create a cumulative ID for the event
        .withColumn(
            'event_id',
            F.sum('price_change').over(window_seg.rowsBetween(Window.unboundedPreceding, 0))
        )
    )

    # 3) Metadata: Determine Start and End Date for each Event
    events_meta = (
        df_with_events
        .groupBy(*seg_cols, 'event_id')
        .agg(F.min('ORDER_DATE').alias('start_date'))
    )

    # The end date of an event is the start date of the NEXT event
    window_event = Window.partitionBy(*seg_cols).orderBy('start_date')
    events_meta = (
        events_meta
        .withColumn('end_date', F.lead('start_date').over(window_event))
    )

    # 4) Calculate Aggregated Sales (Qn)
    # Join metadata back to the main data
    df_to_calc = df_with_events.join(events_meta, on=seg_cols + ['event_id'], how="left")

    # Define the effective cutoff date: Min(Next Event Start, Start + n_weeks)
    n_weeks_limit_date = F.date_add(F.col('start_date'), n_weeks * 7)
    
    effective_end_date = F.when(
        F.col('end_date').isNull(), n_weeks_limit_date
    ).otherwise(
        F.least(F.col('end_date'), n_weeks_limit_date)
    )

    # Filter rows that fall within the valid window for the specific event
    df_filtered = df_to_calc.filter(
        (F.col('ORDER_DATE') >= F.col('start_date')) &
        (F.col('ORDER_DATE') < effective_end_date)
    )

    # Aggregate
    qn_df = (
        df_filtered
        .groupBy(*seg_cols, 'event_id')
        .agg(F.sum(sales_col).alias(f'Q{n_weeks}'))
    )

    # 5) Final Join: Attach the calculated Qn back to the full dataset
    # We return the full dataset enriched with event info
    df_final = (
        df_with_events
        .join(events_meta, on=seg_cols + ['event_id'], how='left')
        .join(qn_df, on=seg_cols + ['event_id'], how='left')
        .fillna({f'Q{n_weeks}': 0})
    )

    return df_final

# COMMAND ----------

# Configuration for the Event Window
N_WEEKS   = 26
SALES_COL = 'BILLED_QTY'

# Defining segmentation hierarchy for price uniqueness
SEGMENTATION_COLS = [
    'EAN_CODE', 'BUSINESS_UNIT', 'SUB_BU', 'BRAND', 'REGION_STATE',
    'SUB_CHANNEL', 'SALES_TEAM_CHANNEL',
    'TEAM_CATEGORY_NAME', 'BRAND_CATEGORY'
]

# Execute Calculation
df_result = compute_long_term_sales(
    df_no_outliers, 
    n_weeks=N_WEEKS, 
    sales_col=SALES_COL, 
    seg_cols=SEGMENTATION_COLS
)

# Remove events with zero accumulated quantity (data quality check)
df_result = df_result.filter(col(f"Q{N_WEEKS}") != 0)

# COMMAND ----------

# Feature Engineering: Gap between Applied List Price and Market Price
df_result = df_result.withColumn(
    "PRICE_GAP_VS_MARKET",
    col("LIST_PRICE_UNIT") - col("MARKET_PRICE_UNIT")
)

# COMMAND ----------

# MAGIC %md
# MAGIC ## 💾 5. Saving Data

# COMMAND ----------

# Write to Delta Lake
table_name = 'finance_db.gold_sales_events_enriched'

df_result.write \
    .format('delta') \
    .mode('overwrite') \
    .option("overwriteSchema", "true") \
    .saveAsTable(table_name)